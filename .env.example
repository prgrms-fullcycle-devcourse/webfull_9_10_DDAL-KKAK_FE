# 백엔드 API 베이스 URL
# dev (Render): https://travel-tick.onrender.com
# 로컬 백엔드 띄울 때: http://localhost:8080
# Express가 `/expenses`에 마운트된 기준 URL
VITE_API_BASE_URL=https://travel-tick.onrender.com

# (선택) 배포 앱에서 Playwright 고화질 리포트 캡처 — screenshot 서버 공개 URL (끝에 / 없이)
# 예: https://travel-tick-screenshots.onrender.com
# 비우면: 로컬 dev에서만 Vite 프록시(/__screenshot) 사용, 프로덕션은 브라우저 캡처만
# VITE_SCREENSHOT_SERVER_URL=

# (선택) 스크린샷 서버에 SCREENSHOT_SECRET을 켰을 때 같은 값을 넣음 (프론트 번들에 포함됨)
# VITE_SCREENSHOT_SECRET=
